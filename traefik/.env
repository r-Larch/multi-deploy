TRAEFIK_ACME_EMAIL=example@email.com

# Traefik dashboard settings:
TRAEFIK_DASHBOARD_ENABLE=false
TRAEFIK_DASHBOARD_HOST=traefik.example.com

# Docker API version used by Traefik's docker provider (default 1.44).
# Lower it if your Docker Engine is older and rejects 1.44 as "too new".
#DOCKER_API_VERSION=1.44
